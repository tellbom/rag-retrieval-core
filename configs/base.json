{
  "version": "0.1.0",

  "standard_fields": {
    "fields": [
      { "name": "doc_id",          "type": "keyword",  "filterable": true,  "required": true },
      { "name": "chunk_id",        "type": "keyword",  "filterable": true,  "required": true },
      { "name": "parent_id",       "type": "keyword",  "filterable": true,  "required": false },
      { "name": "hierarchy_level", "type": "integer",  "filterable": true,  "required": false },
      { "name": "position",        "type": "integer",  "filterable": false, "required": false },
      { "name": "title",           "type": "text",     "filterable": false, "highlightable": true, "analyzer": "ik_max_word", "required": false },
      { "name": "source",          "type": "keyword",  "filterable": true,  "required": false },
      { "name": "business_type",   "type": "keyword",  "filterable": true,  "required": true },
      { "name": "category",        "type": "keyword",  "filterable": true,  "required": false },
      { "name": "created_time",    "type": "date",     "filterable": true,  "required": false },
      { "name": "updated_time",    "type": "date",     "filterable": true,  "required": false },
      { "name": "author",          "type": "keyword",  "filterable": true,  "required": false },
      { "name": "text",            "type": "text",     "filterable": false, "highlightable": true, "analyzer": "ik_max_word", "required": true },
      { "name": "config_version",  "type": "keyword",  "filterable": true,  "required": true },
      { "name": "embedding_model_versions", "type": "keyword", "filterable": true, "required": false }
    ]
  },

  "models": {
    "embeddings": [
      {
        "id":          "text2vec_large_chinese",
        "name":        "text2vec-large-chinese",
        "version":     "local",
        "endpoint":    "http://192.168.124.2:18081",
        "vector_name": "text2vec_large_chinese",
        "dimension":   1024,
        "batch_size":  8,
        "max_seq_len": 512,
        "normalize":   true,
        "use_late_chunking": false
      },
      {
        "id":          "bge_m3",
        "name":        "BAAI/bge-m3",
        "version":     "local",
        "endpoint":    "http://192.168.124.2:18082",
        "vector_name": "bge_m3",
        "dimension":   1024,
        "batch_size":  8,
        "max_seq_len": 8192,
        "normalize":   true,
        "use_late_chunking": true
      }
    ],
    "reranker": {
      "name":            "BAAI/bge-reranker-v2-m3",
      "version":         "onnx-local",
      "endpoint":        "http://192.168.124.2:18084",
      "max_concurrency": 4,
      "timeout_seconds": 120
    },
    "enhancement_llm": {
      "endpoint":        "https://api.aigc369.com/v1",
      "model":           "gpt-4o",
      "api_key_env":     "OPENAI_API_KEY",
      "timeout_seconds": 60,
      "max_tokens":      1024
    }
  },

  "storage": {
    "base_name": "rag_chunks",
    "elasticsearch": {
      "hosts": ["http://192.168.124.2:19200"],
      "timeout_seconds": 30,
      "max_retries": 3
    },
    "qdrant": {
      "url": "http://192.168.124.2:6333",
      "timeout_seconds": 30
    }
  },

  "chunking": {
    "length": {
      "max_tokens":                  400,
      "overlap_tokens":              40,
      "context_preservation_tokens": 80
    },
    "structural": {
      "enabled": true,
      "levels":  ["heading", "clause", "paragraph", "list_item", "table"]
    },
    "semantic": {
      "enabled":            false,
      "min_trigger_tokens": 256,
      "strategy":           "late_chunking"
    }
  },

  "retrieval": {
    "retrievers": [
      {
        "id":     "es_bm25",
        "type":   "lexical",
        "engine": "elasticsearch",
        "top_k":  100,
        "weight": 1.0
      },
      {
        "id":          "qd_text2vec_large_chinese",
        "type":        "dense",
        "engine":      "qdrant",
        "model_id":    "text2vec_large_chinese",
        "vector_name": "text2vec_large_chinese",
        "top_k":       100,
        "weight":      1.0
      },
      {
        "id":          "qd_bge_m3",
        "type":        "dense",
        "engine":      "qdrant",
        "model_id":    "bge_m3",
        "vector_name": "bge_m3",
        "top_k":       100,
        "weight":      1.0
      }
    ],
    "fusion": {
      "method":    "weighted_rrf",
      "k":         60,
      "pool_top_k": 200
    },
    "rerank": {
      "enabled":       true,
      "top_k":         50,
      "context_top_k": 8
    },
    "top_k_ladder": {
      "recall_top_k": 100,
      "rrf_pool_k":   200,
      "rerank_top_k": 50,
      "context_top_k": 8
    }
  },

  "enhancement": {
    "enabled":       true,
    "mutate_source": false,
    "derived_fields": {
      "summary":             true,
      "keywords":            true,
      "entities":            true,
      "potential_questions": false,
      "context_padding":     false
    },
    "degradation_policy": "rules_only_and_flag"
  }
}
